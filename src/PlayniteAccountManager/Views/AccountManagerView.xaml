<UserControl x:Class="PlayniteAccountManager.Views.AccountManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="820" MinHeight="520"
             Background="#121212">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="PanelBrush2" Color="#202020"/>
        <SolidColorBrush x:Key="InputBrush" Color="#050505"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#686868"/>
        <SolidColorBrush x:Key="BorderBrushFocus" Color="#D8D8D8"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#BDBDBD"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#7D7D7D"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#353535"/>
                    <Setter Property="BorderBrush" Value="#707070"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#414141"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.38"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" BasedOn="{StaticResource DarkButton}" TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushFocus}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushFocus}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark launcher selector: custom template so the drop-down stays readable in Playnite dark theme -->
        <Style x:Key="LauncherComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#323232"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#383838"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LauncherComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#050505"/>
            <Setter Property="BorderBrush" Value="#686868"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource LauncherComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <ContentPresenter x:Name="SelectionBox"
                                                      Margin="{TemplateBinding Padding}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      RecognizesAccessKey="True"
                                                      SnapsToDevicePixels="True"/>

                                    <ToggleButton x:Name="DropDownButton"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  ClickMode="Press"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  HorizontalAlignment="Right"
                                                  Width="38">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent">
                                                    <Path x:Name="Arrow"
                                                          Data="M 0 0 L 8 8 L 16 0 Z"
                                                          Width="14" Height="7"
                                                          Fill="#DADADA"
                                                          Stretch="Fill"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border Margin="0,4,0,0"
                                        Background="#171717"
                                        BorderBrush="#555555"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="300"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#D8D8D8"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#D8D8D8"/>
                                <Setter TargetName="DropDownButton" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="BorderBrush" Value="#2C2C2C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,6,2,0"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>

        <Style x:Key="FieldBlock" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#2E2E2E"/>
        </Style>

        <Style x:Key="AccentButton" BasedOn="{StaticResource DarkButton}" TargetType="Button">
            <Setter Property="Background" Value="#1F4E8C"/>
            <Setter Property="BorderBrush" Value="#3A70B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#285FA8"/>
                    <Setter Property="BorderBrush" Value="#5B8FD6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerTitle}" FontSize="24" FontWeight="SemiBold" Foreground="#F4F4F4"/>
                <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerSubtitle}" Margin="0,3,0,0" FontSize="13" Foreground="#A5A5A5" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="NewAccountButton" Content="{DynamicResource LOCPlayniteAccountManagerAddAccount}"
                    Style="{StaticResource PrimaryButton}" MinWidth="160" Margin="16,0,0,0" FontSize="13"
                    VerticalAlignment="Center" Click="NewAccountButton_Click"/>
        </Grid>

        <!-- Selected games banner -->
        <Border Grid.Row="1" Margin="0,0,0,14" CornerRadius="10" Padding="16,12" BorderThickness="4,1,1,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#14202F"/>
                    <Setter Property="BorderBrush" Value="#3A70B8"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasContextGames}" Value="False">
                            <Setter Property="Background" Value="#181818"/>
                            <Setter Property="BorderBrush" Value="#3A3A3A"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Visibility="{Binding HasContextGames, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ContextBannerTitle}" FontSize="12" Foreground="#8FB4E8" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ContextBannerGames}" Margin="0,3,0,0" FontSize="17" FontWeight="SemiBold"
                               Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ContextBannerAssignment}" Margin="0,3,0,0" FontSize="13" Foreground="#C9D6E8"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasContextBannerAssignment, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerNoGameSelected}" FontSize="13" Foreground="#A5A5A5"
                           TextWrapping="Wrap"
                           Visibility="{Binding NoContextGames, Converter={StaticResource BoolToVisibility}}"/>
                <Button Grid.Column="1" x:Name="AssignButton" Content="{DynamicResource LOCPlayniteAccountManagerAssign}"
                        Style="{StaticResource AccentButton}" Margin="16,0,0,0" MinWidth="220" VerticalAlignment="Center"
                        Click="AssignButton_Click" IsEnabled="False"
                        Visibility="{Binding HasContextGames, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.36*" MinWidth="250" MaxWidth="380"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Accounts -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="10"
                    BorderBrush="#2B2B2B" BorderThickness="1" Padding="12,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerSavedAccounts}" Margin="4,0,0,10"
                               FontSize="12" Foreground="#C8C8C8" FontWeight="SemiBold"/>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="AccountsList"
                                 ItemsSource="{Binding Accounts}"
                                 SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                 SelectionChanged="AccountsList_SelectionChanged"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,4,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="#171717" BorderBrush="#2A2A2A"
                                                        BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#202020"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#26303D"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3A70B8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="#1F4E8C"
                                                    Visibility="{Binding IsAssignedToContext, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding AssignedTag}" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="#F4F4F4"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding LauncherName}" FontSize="12" Foreground="#CFCFCF" VerticalAlignment="Center"/>
                                            <Border Visibility="{Binding HasModeTag, Converter={StaticResource BoolToVisibility}}">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAutomatic}" Value="True">
                                                                <Setter Property="Background" Value="#1E4A2E"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ModeTag}" FontSize="10" FontWeight="SemiBold" Foreground="#E8E8E8"/>
                                            </Border>
                                            <Border Style="{StaticResource Pill}" Background="#4A3A12"
                                                    Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding PrimaryTag}" FontSize="10" FontWeight="SemiBold" Foreground="#F5DFA0"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding UserName}" Margin="0,4,0,0" FontSize="12" Foreground="#9A9A9A"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyAccountsText"
                                   Text="{DynamicResource LOCPlayniteAccountManagerNoSavedAccounts}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="12" FontSize="13" Foreground="#8A8A8A"
                                   IsHitTestVisible="False" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Editor -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="10"
                    BorderBrush="#2B2B2B" BorderThickness="1" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="EditorStatusText" Grid.Row="0" Margin="22,18,22,12"
                               Text="{DynamicResource LOCPlayniteAccountManagerNewAccount}"
                               FontSize="22" FontWeight="SemiBold" Foreground="#F4F4F4" TextTrimming="CharacterEllipsis"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="22,0,22,4">
                        <StackPanel>
                            <!-- Account -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerSectionAccount}" Style="{StaticResource SectionTitle}"/>

                                    <StackPanel Style="{StaticResource FieldBlock}">
                                        <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerLauncher}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="LauncherCombo" Style="{StaticResource LauncherComboBox}" ItemsSource="{Binding Launchers}"
                                                  SelectedValuePath="Value" SelectedValue="{Binding EditLauncher, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#F2F2F2" FontSize="14"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Style="{StaticResource FieldBlock}">
                                            <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerAccountName}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="NameTextBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Style="{StaticResource FieldBlock}">
                                            <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerLoginEmail}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="UserNameTextBox" Text="{Binding EditUserName, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerPassword}" Style="{StaticResource FieldLabel}"/>
                                        <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/>
                                        <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerKeepPassword}" Style="{StaticResource HintText}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Login -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerSectionLogin}" Style="{StaticResource SectionTitle}"/>

                                    <StackPanel Visibility="{Binding IsUbisoftConnectLauncher, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerUbisoftLoginMode}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="UbisoftLoginModeCombo" Style="{StaticResource LauncherComboBox}"
                                                  ItemsSource="{Binding UbisoftLoginModes}" SelectedValuePath="Value"
                                                  SelectedValue="{Binding EditUbisoftLoginMode, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#F2F2F2" FontSize="14"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerUbisoftManualHint}" Style="{StaticResource HintText}"/>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding IsEpicGamesLauncher, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerEpicLoginMode}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="EpicLoginModeCombo" Style="{StaticResource LauncherComboBox}"
                                                  ItemsSource="{Binding EpicLoginModes}" SelectedValuePath="Value"
                                                  SelectedValue="{Binding EditEpicLoginMode, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#F2F2F2" FontSize="14"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerEpicManualHint}" Style="{StaticResource HintText}"/>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding IsEAAppLauncher, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerEALoginMode}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="EALoginModeCombo" Style="{StaticResource LauncherComboBox}"
                                                  ItemsSource="{Binding EALoginModes}" SelectedValuePath="Value"
                                                  SelectedValue="{Binding EditEALoginMode, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#F2F2F2" FontSize="14"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerEAManualHint}" Style="{StaticResource HintText}"/>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding IsGOGGalaxyLauncher, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerGOGLoginMode}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="GOGLoginModeCombo" Style="{StaticResource LauncherComboBox}"
                                                  ItemsSource="{Binding GOGLoginModes}" SelectedValuePath="Value"
                                                  SelectedValue="{Binding EditGOGLoginMode, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#F2F2F2" FontSize="14"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerGOGManualHint}" Style="{StaticResource HintText}"/>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding IsBattleNetLauncher, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerBattleNetLoginMode}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="BattleNetLoginModeCombo" Style="{StaticResource LauncherComboBox}"
                                                  ItemsSource="{Binding BattleNetLoginModes}" SelectedValuePath="Value"
                                                  SelectedValue="{Binding EditBattleNetLoginMode, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#F2F2F2" FontSize="14"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerBattleNetManualHint}" Style="{StaticResource HintText}"/>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding IsSteamLauncher, Converter={StaticResource BoolToVisibility}}">
                                        <CheckBox x:Name="PrimaryAccountCheck" Content="{DynamicResource LOCPlayniteAccountManagerPrimarySteam}"
                                                  IsChecked="{Binding EditIsPrimary, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsPrimaryEligibleLauncher}" Margin="0"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding LauncherNote}" Style="{StaticResource HintText}"
                                               Visibility="{Binding HasLauncherNote, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Assignment -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerSectionAssignment}" Style="{StaticResource SectionTitle}"/>

                                    <ItemsControl ItemsSource="{Binding ContextGameRows}" Margin="0,0,0,6"
                                                  Visibility="{Binding HasContextGames, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#F0F0F0"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding AssignmentText}" FontSize="12" Margin="12,0,0,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#8A8A8A"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasAssignment}" Value="True">
                                                                        <Setter Property="Foreground" Value="#8FB4E8"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding ContextMoreGames}" FontSize="12" Foreground="#8A8A8A" Margin="0,0,0,8"
                                               Visibility="{Binding HasContextMoreGames, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerSelectGames}" Style="{StaticResource HintText}"
                                               Margin="0,0,0,10"
                                               Visibility="{Binding NoContextGames, Converter={StaticResource BoolToVisibility}}"/>

                                    <CheckBox x:Name="AutoLoginCheck" Content="{DynamicResource LOCPlayniteAccountManagerAutoLogin}"
                                              IsChecked="{Binding EditAutoLogin, Mode=TwoWay}"/>
                                    <CheckBox x:Name="LogoutCheck" Content="{DynamicResource LOCPlayniteAccountManagerLogoutAfterGame}"
                                              IsChecked="{Binding EditLogoutAfterGame, Mode=TwoWay}" Margin="0"/>
                                    <TextBlock Text="{DynamicResource LOCPlayniteAccountManagerAssignmentHint}" Style="{StaticResource HintText}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Account actions: always visible -->
                    <Border Grid.Row="2" Background="#151515" BorderBrush="#2B2B2B" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,10,10" Padding="22,12">
                        <WrapPanel HorizontalAlignment="Right">
                            <Button x:Name="TestLoginButton" Content="{DynamicResource LOCPlayniteAccountManagerTestAuto}"
                                    Style="{StaticResource DarkButton}" Margin="0,4,8,4" Click="TestLoginButton_Click"/>
                            <Button x:Name="DeleteButton" Content="{DynamicResource LOCPlayniteAccountManagerDelete}"
                                    Style="{StaticResource DarkButton}" Margin="0,4,8,4" Click="DeleteButton_Click" IsEnabled="False"/>
                            <Button x:Name="SaveButton" Content="{DynamicResource LOCPlayniteAccountManagerSave}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,4,0,4" Click="SaveButton_Click"/>
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,12,0,0" Background="#171717" BorderBrush="#282828" BorderThickness="1"
                CornerRadius="8" Padding="12,9">
            <TextBlock x:Name="StatusText" Text="{DynamicResource LOCPlayniteAccountManagerStatusEmpty}"
                       FontSize="12" Foreground="#B0B0B0" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
